# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 ENVIRONMENT VARIABLES - VIDEO MAESTRO V3 (RENDER FREE TIER)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Configuration pour déploiement Render gratuit
# 100% open source - 0€/mois
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚀 Server Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NODE_ENV=production
PORT=3000
NODE_OPTIONS=--max-old-space-size=384

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔴 Redis Upstash (GRATUIT - TLS Required)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Créer compte: https://console.upstash.com/
# Plan: Free (10,000 commandes/jour)
# Copier "TLS (SSL) URL"
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6380

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔥 Firebase Backend (GRATUIT)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Firebase Console → Project Settings → Service Accounts
# → Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📁 File Storage (Éphémère sur Render Free)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# Nettoyage automatique (jours) - 1 jour pour free tier
AUTO_CLEANUP_DAYS=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎤 TTS Service (Piper - Gratuit)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TTS_SERVICE_URL=http://localhost:5001
PIPER_MODELS_DIR=/opt/piper/models

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎙️ Transcription (Faster-Whisper TINY - Gratuit)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
WHISPER_SERVICE_URL=http://localhost:5002
WHISPER_MODEL_SIZE=tiny
WHISPER_MODELS_DIR=/opt/whisper/models

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎬 FFmpeg Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔒 Security
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ALLOWED_ORIGINS=https://video-maestros.netlify.app,https://localhost:3000

# Rate limiting (réduit pour free tier)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📊 Monitoring (Désactivé pour économiser RAM)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LOG_LEVEL=info
ENABLE_METRICS=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📺 Start.io Ads (GRATUIT)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Créer compte: https://portal.start.io/
STARTIO_ENABLED=true
STARTIO_PUBLISHER_ID=YOUR_PUBLISHER_ID

# Prix abonnement Premium (FCFA)
PREMIUM_PRICE=2000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚫 OLLAMA DÉSACTIVÉ (Trop lourd pour Render Free - 2GB+ RAM)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📝 NOTES RENDER FREE TIER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Contraintes:
# - RAM: 512MB (optimisé à 384MB pour Node.js)
# - CPU: 0.1 vCPU partagé
# - Disk: 0GB persistent (fichiers éphémères)
# - Service s'endort après 15min d'inactivité
# - Cold start: ~30s après sommeil
#
# Services inclus (GRATUITS):
# ✅ FFmpeg (léger)
# ✅ Faster-Whisper TINY (50MB model)
# ✅ Piper TTS (léger)
# ✅ Python 3.11 + Flask
# ✅ Node.js 20 LTS
# ✅ Redis externe (Upstash Free)
# ❌ Ollama DÉSACTIVÉ (trop lourd)
#
# Coût total: 0€/mois (100% GRATUIT)
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
