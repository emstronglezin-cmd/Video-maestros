{
  "name": "Video Maestro - Montage Vidéo IA",
  "short_name": "Video Maestro",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0A0E21",
  "theme_color": "#667EEA",
  "description": "Application de montage vidéo automatique avec intelligence artificielle",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Créer une vidéo",
      "short_name": "Créer",
      "description": "Créer une nouvelle vidéo avec IA",
      "url": "/?action=create",
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Mes vidéos",
      "short_name": "Vidéos",
      "description": "Voir mes vidéos créées",
      "url": "/?action=videos",
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "categories": ["productivity", "multimedia"],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "video",
          "accept": ["video/*", "image/*"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+videomaestro",
      "url": "/?video=%s"
    }
  ],
  "screenshots": [
    {
      "src": "icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ]
}
